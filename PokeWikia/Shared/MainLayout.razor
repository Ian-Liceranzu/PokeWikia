@inherits LayoutComponentBase

<MudThemeProvider Theme="customTheme" />
<MudPopoverProvider />

<MudDialogProvider />

<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code{

    MudTheme customTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#AA53C6",
            Secondary= "#7053C6"
        }
    };

}