@page "/routes"

@using PokeApiNet
@using PokeWikia.Pages.Dialogs
@using PokeWikia.Utils.Models

@inject HttpClient Http
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-4">Pokémon Routes & Encounters</MudText>

        @if (_encounters.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                <MudText>Loading encounters...</MudText>
                <MudProgressLinear Indeterminate="true" Class="mt-2"/>
            </MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="@_pokemonNameFilterValue"
                                  Label="Search Pokémon"
                                  Placeholder="Enter Pokémon name..."
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true"
                                  OnClearButtonClick="@(async () => await ClearFilter())"
                                  OnKeyDown="@(e => { if (e.Key == "Enter") { ApplyFilter(); } })"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"/>
                </MudItem>
                <MudItem xs="12" sm="6" md="8" Class="d-flex justify-end">
                    <MudChipSet T="int" Class="ml-auto">
                        <MudChip T="int" Color="Color.Primary" Size="Size.Small">
                            @_encounters.Count
                        </MudChip>
                        @if (!string.IsNullOrEmpty(_pokemonNameFilterValue))
                        {
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small"
                                     OnClose="@(async () => await ClearFilter())">
                                Pokémon: @_pokemonNameFilterValue
                            </MudChip>
                        }
                    </MudChipSet>
                </MudItem>
            </MudGrid>

            <MudTable T="Encounters" Items="@_filteredEncounters" Dense="true" Hover="true" Bordered="false" 
                      Striped="true" Elevation="0" Context="encounter" Class="mt-4">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Encounter List</MudText>
                </ToolBarContent>

                <HeaderContent>
                    <MudTh>Route</MudTh>
                    <MudTh class="text-center">Total Encounters</MudTh>
                    <MudTh class="text-center">Pokémon Species</MudTh>
                    <MudTh class="text-center">Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Route">
                        <MudText Typo="Typo.body1" FontWeight="FontWeight.Bold">
                            @encounter.RouteName (@encounter.RouteId?.Trim('[', ']'))
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Total Encounters" Class="text-center">
                        <MudChip T="int" Color="Color.Primary" Size="Size.Small">
                            @encounter.WildEncounters.Sum(e => e.EncounterRatios.Count)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Pokémon Species" Class="text-center">
                        <MudChip T="int" Color="Color.Secondary" Size="Size.Small">
                            @encounter.WildEncounters.SelectMany(e => e.EncounterRatios).Select(r => r.Pokemon.Name).Distinct().Count()
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="text-center">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => OpenRouteDialog(encounter)"
                                   StartIcon="@Icons.Material.Filled.Visibility">
                            View Details
                        </MudButton>
                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="@([10, 20, 50])"/>
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    PokeApiClient _pokeApiClient = new();
    List<Encounters> _encounters = [];
    List<Encounters> _filteredEncounters = [];
    string _pokemonNameFilterValue = string.Empty;

    // Cache for loaded Pokémon - IMPORTANT for performance
    private Dictionary<string, Pokemon> _pokemonCache = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEncounters();
        await ApplyFilter();
    }

    private async Task LoadEncounters()
    {
        var text = await Http.GetStringAsync("sample-data/sample-essentials-encounters.txt");
        var routes = text.Split("#-------------------------------", StringSplitOptions.RemoveEmptyEntries);

        _encounters.Clear();

        foreach (var route in routes)
        {
            var encounter = ParseEncounterBlock(route);
            if (encounter != null && encounter.WildEncounters.Any())
            {
                _encounters.Add(encounter);
            }
        }
    }

    private Encounters ParseEncounterBlock(string block)
    {
        var encounter = new Encounters { WildEncounters = [] };
        var lines = block.Split([Environment.NewLine, "\n", "\r\n"], StringSplitOptions.RemoveEmptyEntries);

        WildEncounter currentWildEncounter = null;

        foreach (var rawLine in lines)
        {
            var trimmedLine = rawLine.Trim();

            if (string.IsNullOrWhiteSpace(trimmedLine))
                continue;

            // Skip comments that are on their own line
            if (trimmedLine.StartsWith("#") && !trimmedLine.Contains("[") && !rawLine.Contains("["))
                continue;

            // Parse route ID and name
            if (trimmedLine.StartsWith("[") && trimmedLine.Contains("]"))
            {
                // Extract route ID (everything between [ and ])
                var bracketEnd = trimmedLine.IndexOf(']');
                encounter.RouteId = trimmedLine[..(bracketEnd + 1)];

                // Extract route name (after # if exists)
                var hashIndex = trimmedLine.IndexOf('#');
                if (hashIndex > 0 && hashIndex < trimmedLine.Length - 1)
                {
                    encounter.RouteName = trimmedLine[(hashIndex + 1)..].Trim();
                }

                continue;
            }

            // Skip comment lines
            if (trimmedLine.StartsWith("#"))
                continue;

            // Check if this is an encounter type line (not starting with a digit and not empty)
            if (!char.IsDigit(trimmedLine[0]) && !trimmedLine.StartsWith("["))
            {
                // Save previous wild encounter if it exists and has data
                if (currentWildEncounter != null && currentWildEncounter.EncounterRatios.Count > 0)
                {
                    encounter.WildEncounters.Add(currentWildEncounter);
                }

                // Parse encounter type
                var parts = trimmedLine.Split(',');
                var typeName = parts[0].Trim();
                var frequency = parts.Length > 1 ? int.Parse(parts[1].Trim()) : 100;

                currentWildEncounter = new WildEncounter
                {
                    EncounterType = ParseEncounterType(typeName),
                    Frequency = frequency,
                    EncounterRatios = []
                };
            }
            // Parse Pokémon data (starts with digit or has leading space)
            else if (currentWildEncounter != null)
            {
                // Remove any leading spaces or tabs
                var cleanLine = rawLine.TrimStart();

                // Check if this line starts with a number (rate)
                if (cleanLine.Length <= 0 || !char.IsDigit(cleanLine[0])) continue;
                
                var parts = cleanLine.Split(',');
                if (parts.Length < 4) continue;
                
                // Clean each part
                for (var i = 0; i < parts.Length; i++)
                {
                    parts[i] = parts[i].Trim();
                }

                if (!int.TryParse(parts[0], out var rate)) continue;

                var pokemonName = parts[1].Trim();
                var minLevel = int.Parse(parts[2]);
                var maxLevel = int.Parse(parts[3]);

                var encounterRatio = new EncounterRatio
                {
                    Rate = rate,
                    Pokemon = new Pokemon { Name = pokemonName },
                    Levels = [minLevel, maxLevel]
                };
                currentWildEncounter.EncounterRatios.Add(encounterRatio);
            }
        }

        // Add the last wild encounter
        if (currentWildEncounter != null && currentWildEncounter.EncounterRatios.Count > 0)
        {
            encounter.WildEncounters.Add(currentWildEncounter);
        }

        return encounter;
    }

    private EncounterTypes ParseEncounterType(string typeString)
    {
        return typeString switch
        {
            "Land" or "Grass" => EncounterTypes.Land,
            "LandNight" => EncounterTypes.LandNight,
            "LandMorning" => EncounterTypes.LandMorning,
            "Water" => EncounterTypes.Water,
            "WaterNight" => EncounterTypes.WaterNight,
            "Cave" => EncounterTypes.Cave,
            "CaveNight" => EncounterTypes.CaveNight,
            "OldRod" => EncounterTypes.OldRod,
            "GoodRod" => EncounterTypes.GoodRod,
            "SuperRod" => EncounterTypes.SuperRod,
            "RockSmash" => EncounterTypes.RockSmash,
            "HeadbuttLow" => EncounterTypes.HeadbuttLow,
            "HeadbuttHigh" => EncounterTypes.HeadbuttHigh,
            "BugContest" => EncounterTypes.BugContest,
            _ => EncounterTypes.Land
        };
    }

    private async Task ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_pokemonNameFilterValue))
        {
            _filteredEncounters = _encounters.ToList();
        }
        else
        {
            _filteredEncounters = _encounters
                .Where(e => e.WildEncounters
                    .Any(w => w.EncounterRatios
                        .Any(r => r.Pokemon.Name.Contains(_pokemonNameFilterValue, StringComparison.OrdinalIgnoreCase))))
                .ToList();
        }

        StateHasChanged();
    }

    private async Task ClearFilter()
    {
        _pokemonNameFilterValue = string.Empty;
        await ApplyFilter();
    }

    // Cache-aware sprite loading
    private async Task<Pokemon> LoadPokemonSprite(string pokemonName)
    {
        // Check cache first
        if (_pokemonCache.TryGetValue(pokemonName, out var sprite))
        {
            return sprite;
        }

        try
        {
            var pokemon = await _pokeApiClient.GetResourceAsync<Pokemon>(pokemonName);
            _pokemonCache[pokemonName] = pokemon;
            return pokemon;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading {pokemonName}: {ex.Message}");
            return new Pokemon { Name = pokemonName };
        }
    }

    private async void OpenRouteDialog(Encounters encounter)
    {
        var parameters = new DialogParameters
        {
            ["Encounter"] = encounter,
            ["LoadPokemonSprite"] = new Func<string, Task<Pokemon>>(LoadPokemonSprite),
            ["PokemonCache"] = _pokemonCache
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<RouteDialog>("Route Details", parameters, options);
    }

}